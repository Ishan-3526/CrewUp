PORT=3000
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Comma-separated emails that get admin powers (must be registered accounts)
ADMIN_EMAILS=you@example.com
# Postgres connection string from Neon, Supabase, or any Postgres host. REQUIRED.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Password reset emails (optional). Free key at resend.com. Without it, links print in the server log
# and admins can generate links from the Admin page.
RESEND_API_KEY=
MAIL_FROM=Crewup <onboarding@resend.dev>
BASE_URL=https://your-app.onrender.com
